# ==============================================================================
# FinAuditPro - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides. All variables have safe defaults
# for 100% offline local desktop execution.

# Application Environment (development, testing, production)
FINAUDIT_ENV=development

# Custom SQLite Database Path (Defaults to backend/finauditpro.db)
FINAUDIT_DB_PATH=backend/finauditpro.db

# JWT Secret Key for Session Authentication (Defaults to auto-generated key in DB)
FINAUDIT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key

# Local AI Engine Endpoint (LM Studio OpenAI-compatible local server)
LOCAL_AI_ENDPOINT=http://localhost:1234
LOCAL_AI_MODEL=qwen2.5-coder-14b-instruct-mlx

# Server Host and Port
HOST=127.0.0.1
PORT=8000
